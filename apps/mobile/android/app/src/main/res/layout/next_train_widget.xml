<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/next_train_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_station_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/next_train_widget_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_line_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/next_train_widget_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_departures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_direction_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/next_train_widget_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_departure_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/next_train_widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_direction_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/next_train_widget_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_departure_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/next_train_widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/next_train_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
