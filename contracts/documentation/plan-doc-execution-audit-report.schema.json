{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "observedAt", "inputs", "summary", "records", "findings", "incomplete"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["COMPLETE", "AUDIT_INCOMPLETE"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "inputs": { "type": "object", "additionalProperties": false, "required": ["sourceSha", "scopeSha256", "executionRepository"], "properties": { "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "scopeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "executionRepository": { "const": "AquilaXk/easysubway" } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["records", "findings", "incomplete"], "properties": { "records": { "type": "integer", "minimum": 0 }, "findings": { "type": "integer", "minimum": 0 }, "incomplete": { "type": "integer", "minimum": 0 } } },
    "records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "issueNumber", "prNumber", "repository", "mergeSha", "changedFiles"], "properties": { "kind": { "enum": ["HISTORICAL", "SELF"] }, "issueNumber": { "type": "integer", "minimum": 1 }, "prNumber": { "type": "integer", "minimum": 1 }, "repository": { "const": "AquilaXk/easysubway" }, "mergeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "changedFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } } },
    "findings": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["code", "identity"], "properties": { "code": { "enum": ["DUPLICATE_PR", "DUPLICATE_MERGE_SHA", "EXECUTION_REPOSITORY_MISMATCH", "MERGE_SHA_MISMATCH", "RELATION_MISMATCH", "TARGET_PATH_MODIFICATION", "SELF_SOURCE_SHA_MISMATCH", "SELF_CLOSING_ISSUE_MISMATCH"] }, "identity": { "type": "string", "pattern": "^[A-Za-z0-9:._/-]+$" } } } },
    "incomplete": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["stage", "code", "affectedIdentity"], "properties": { "stage": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "affectedIdentity": { "type": "string", "pattern": "^[A-Za-z0-9:._/-]+$" } } } }
  },
  "oneOf": [
    { "type": "object", "properties": { "status": { "const": "COMPLETE" }, "incomplete": { "type": "array", "maxItems": 0 } } },
    { "type": "object", "properties": { "status": { "const": "AUDIT_INCOMPLETE" }, "incomplete": { "type": "array", "minItems": 1 } } }
  ]
}
