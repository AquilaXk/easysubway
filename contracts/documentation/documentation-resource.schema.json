{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easysubway/contracts/documentation/documentation-resource",
  "title": "EasySubway documentation resource",
  "type": "object",
  "required": [
    "resource", "resourceClass", "documentationFamily", "kindCandidate", "sourceSurface",
    "canonicalIdentity", "status", "ownerRepository", "ownerIssue", "currentConsumers",
    "releaseReachability", "publicSurfaceReachability", "assertionState", "sensitivity",
    "duplicateGroup", "disposition", "deletePrerequisite", "supersedes", "supersededBy",
    "invalidatedBy", "invalidationReason", "invalidationEvidence", "mutationPolicy",
    "reviewPolicyId", "reviewTrigger", "lastVerifiedAt", "lastVerifiedIdentity",
    "verificationMethod", "verificationEvidence", "nextReviewAtOrSemanticExpiry",
    "implementationPlan", "workloadClass", "orchestrationProfile", "stateClass",
    "configurationDelivery", "healthContract", "availabilityContract", "securityContract",
    "releaseContract", "portabilityOwner", "portabilityEvidence", "portabilityGap"
  ],
  "additionalProperties": false,
  "properties": {
    "resource": { "type": "string", "minLength": 1 },
    "resourceClass": { "type": "string", "enum": ["CANONICAL_RESOURCE", "HUMAN_CONTEXT", "EXECUTABLE_COMPANION", "EVIDENCE", "HUMAN_VIEW"] },
    "documentationFamily": { "type": "string", "enum": ["PRODUCT", "ARCHITECTURE", "API_CONTRACT", "DATA_KNOWLEDGE", "ENGINEERING", "QUALITY_TEST", "RELEASE_CHANGE", "OPERATIONS_RELIABILITY", "SECURITY_PRIVACY", "USER_SUPPORT_LEGAL_PUBLIC", "GOVERNANCE_EVIDENCE"] },
    "kindCandidate": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "sourceSurface": { "type": "string", "enum": ["TRACKED", "PUBLIC", "LOCAL_ONLY", "EXTERNAL"] },
    "canonicalIdentity": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["PROPOSED", "ACTIVE", "SUPERSEDED", "REVOKED", "HISTORICAL", "INVALIDATED"] },
    "ownerRepository": { "type": "string", "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-data", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] },
    "ownerIssue": { "type": ["string", "null"] },
    "currentConsumers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "releaseReachability": { "type": "string", "enum": ["NONE", "BUILD", "RUNTIME", "DEPLOY", "PUBLIC", "EVIDENCE"] },
    "publicSurfaceReachability": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "assertionState": { "type": "string", "enum": ["CURRENTLY_IMPLEMENTED_AND_EVIDENCED", "CURRENT_EXTERNAL_OR_DATA_BLOCKER", "REQUIRED_FINAL_PRODUCTION_BEHAVIOR", "HISTORICAL_OR_SUPERSEDED"] },
    "sensitivity": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "RESTRICTED", "LOCAL_ONLY"] },
    "duplicateGroup": { "type": ["string", "null"] },
    "disposition": { "type": "string", "enum": ["RETAIN_CANONICAL", "MIGRATE_REFERENCE", "GENERATE_VIEW", "SUPERSEDE", "DELETE_AFTER_HANDOFF", "HISTORICAL"] },
    "deletePrerequisite": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supersededBy": { "type": ["string", "null"] },
    "invalidatedBy": { "type": ["string", "null"] },
    "invalidationReason": { "type": ["string", "null"] },
    "invalidationEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "mutationPolicy": { "type": "string", "enum": ["CURRENT_STATE_WITH_CHANGE", "DECISION_APPEND_ONLY", "EVIDENCE_IMMUTABLE", "PLAN_LIVING_BUT_NON_EVIDENCE", "GENERATED_VIEW_DERIVED"] },
    "reviewPolicyId": { "type": "string", "enum": ["EVENT_ONLY", "RELEASE_BOUND", "OPERATIONAL_CRITICAL", "OPERATIONAL_STANDARD", "DATA_FRESHNESS_BOUND", "TOOLCHAIN_BOUND"] },
    "reviewTrigger": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "lastVerifiedAt": { "type": "string", "format": "date-time" },
    "lastVerifiedIdentity": { "type": "string", "minLength": 1 },
    "verificationMethod": { "type": "string", "enum": ["contract-test", "runtime-check", "drill", "release-audit", "owner-review"] },
    "verificationEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nextReviewAtOrSemanticExpiry": { "type": ["string", "null"] },
    "implementationPlan": { "type": "string", "enum": ["PLAN-DOC", "PLAN-REPO", "PLAN-JOURNEY"] },
    "workloadClass": { "type": ["string", "null"], "enum": ["STATELESS_SERVICE", "ONE_SHOT_JOB", "SCHEDULED_JOB", "EXTERNAL_MANAGED_STATE", null] },
    "orchestrationProfile": { "type": ["string", "null"], "enum": ["COMPOSE_CURRENT", "KUBERNETES_CANDIDATE", "KUBERNETES_ACTIVE", null] },
    "stateClass": { "type": ["string", "null"], "enum": ["NONE", "EPHEMERAL_CACHE", "SHARED_DURABLE", "ATOMIC_RELEASE_IDENTITY", null] },
    "configurationDelivery": { "type": ["string", "null"], "enum": ["IMMUTABLE_ENV", "IMMUTABLE_FILE", "EXTERNAL_SECRET_REFERENCE", null] },
    "healthContract": { "type": ["string", "null"] },
    "availabilityContract": { "type": ["string", "null"] },
    "securityContract": { "type": ["string", "null"] },
    "releaseContract": { "type": ["string", "null"] },
    "portabilityOwner": { "type": ["string", "null"] },
    "portabilityEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "portabilityGap": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
