{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easysubway/contracts/documentation/architecture-decision",
  "title": "EasySubway Hub Architecture Decision",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "kind",
    "title",
    "status",
    "date",
    "decisionClass",
    "owner",
    "scope",
    "contextIssue",
    "relatedIssues",
    "context",
    "decisionDrivers",
    "consideredOptions",
    "decisionSchema",
    "decision",
    "consequences",
    "operationalImpact",
    "confirmation",
    "revisitConditions",
    "supersedes",
    "supersededBy"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "const": "./architecture-decision.schema.json" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^ADR-HUB-[0-9]{4}$" },
    "kind": { "type": "string", "const": "architecture-decision" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "withdrawn", "superseded"]
    },
    "date": { "type": "string", "format": "date" },
    "decisionClass": { "type": "string", "enum": ["A", "B"] },
    "owner": {
      "type": "object",
      "required": ["repository", "role"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "const": "AquilaXk/easysubway" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["hub", "data", "backend", "mobile", "platform"] }
    },
    "contextIssue": {
      "type": "string",
      "pattern": "^https://github\\.com/AquilaXk/easysubway/issues/[1-9][0-9]*$"
    },
    "relatedIssues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["repository", "number", "purpose"],
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "enum": [
              "AquilaXk/easysubway",
              "AquilaXk/easysubway-data",
              "AquilaXk/easysubway-backend",
              "AquilaXk/easysubway-mobile",
              "AquilaXk/easysubway-platform"
            ]
          },
          "number": { "type": "integer", "minimum": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisionDrivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "consideredOptions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "chosen", "summary", "pros", "cons", "risks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "chosen": { "type": "boolean" },
          "summary": { "type": "string", "minLength": 1 },
          "pros": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "cons": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "decisionSchema": {
      "type": "string",
      "pattern": "^\\./ADR-HUB-[0-9]{4}-decision\\.schema\\.json$"
    },
    "decision": { "type": "object" },
    "consequences": {
      "type": "object",
      "required": ["positive", "negative", "neutral", "acceptedDebt"],
      "additionalProperties": false,
      "properties": {
        "positive": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "negative": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "neutral": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptedDebt": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "operationalImpact": {
      "type": "object",
      "required": ["initialSlice", "deferredWaves"],
      "additionalProperties": false,
      "properties": {
        "initialSlice": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "deferredWaves": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "confirmation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "method", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "method": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revisitConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ADR-HUB-[0-9]{4}$" }
    },
    "supersededBy": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^ADR-HUB-[0-9]{4}$" }
      ]
    }
  }
}
