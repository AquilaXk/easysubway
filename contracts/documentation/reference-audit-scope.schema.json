{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/reference-audit-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories", "contentClassification", "githubDiscovery", "referenceClasses"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "repositories": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "trackedDiscoveryRoots"],
        "properties": {
          "repository": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] },
          "trackedDiscoveryRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "contentClassification": {
      "type": "object", "additionalProperties": false,
      "required": ["knownBinaryExtensions", "bareReferenceExtensions"],
      "properties": {
        "knownBinaryExtensions": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "bareReferenceExtensions": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "githubDiscovery": {
      "type": "object", "additionalProperties": false,
      "required": ["includeOpenIssues", "includeOpenPullRequests", "maxItemsPerRepository"],
      "properties": {
        "includeOpenIssues": { "const": true },
        "includeOpenPullRequests": { "const": true },
        "maxItemsPerRepository": { "const": 1000 }
      }
    },
    "referenceClasses": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "enum": ["ARTIFACT_IMMUTABLE_REFERENCE", "EXTERNAL_INPUT_PENDING_REFERENCE", "ISSUE_CURRENT_OWNER", "ISSUE_NONCLOSING_DEPENDENCY", "ISSUE_PARENT_OR_COORDINATOR", "ISSUE_TERMINAL_IMPLEMENTATION", "PATH_CANONICAL_CURRENT", "PATH_HISTORICAL_OR_SUPERSEDED", "PR_EVIDENCE_ONLY", "PR_IMPLEMENTATION"] } }
  }
}
