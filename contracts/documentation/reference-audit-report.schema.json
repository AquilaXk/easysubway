{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/reference-audit-report.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "observedAt", "inputs", "summary", "findings", "incomplete"],
  "properties": {
    "schemaVersion": { "const": 1 }, "status": { "enum": ["COMPLETE", "AUDIT_INCOMPLETE"] }, "observedAt": { "type": "string", "format": "date-time" },
    "inputs": { "type": "object", "additionalProperties": false, "required": ["repositories", "migration", "scopeSha256", "sourceSha"], "properties": {
      "repositories": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["repository", "defaultBranch", "gitSha", "selected"], "properties": { "repository": { "type": "string" }, "defaultBranch": { "type": "string" }, "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "selected": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "blobSha"], "properties": { "path": { "type": "string" }, "blobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } } } } } },
      "migration": { "type": "object", "additionalProperties": false, "required": ["ledgerSha256", "amendmentsSha256"], "properties": { "ledgerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "amendmentsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }, "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "scopeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["discovered", "validated", "finding", "incomplete"], "properties": { "discovered": { "type": "integer", "minimum": 0 }, "validated": { "type": "integer", "minimum": 0 }, "finding": { "type": "integer", "minimum": 0 }, "incomplete": { "type": "integer", "minimum": 0 } } },
    "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "referenceClass", "source", "target", "referenced", "latestEffective", "directOwner", "consumerRoute", "reason"], "properties": {
      "code": { "enum": ["BROKEN_OR_UNRESOLVED_REFERENCE", "DISPLAYED_TITLE_DRIFT", "ISSUE_PR_TYPE_CONFUSION", "WRONG_REPOSITORY_OR_OWNER", "CLOSED_NOT_PLANNED_USED_AS_ACTIVE", "SUPERSEDED_USED_AS_CURRENT", "PARENT_CHILD_STATE_DRIFT", "DIRECT_OWNER_BODY_STATE_DRIFT", "PRIORITY_LABEL_MILESTONE_DRIFT", "PLAN_OWNER_OVERLAP", "CANONICAL_PATH_OR_ARTIFACT_DRIFT", "ARTIFACT_LOCATOR_MUTABLE_OR_UNVERIFIED", "NO_FALLBACK_OWNER_OR_POLICY_DRIFT", "REVIEW_FALLBACK_CLASSIFICATION_DRIFT", "UNKNOWN_OR_INVALID"] },
      "referenceClass": { "enum": ["ARTIFACT_IMMUTABLE_REFERENCE", "EXTERNAL_INPUT_PENDING_REFERENCE", "ISSUE_CURRENT_OWNER", "ISSUE_NONCLOSING_DEPENDENCY", "ISSUE_PARENT_OR_COORDINATOR", "ISSUE_TERMINAL_IMPLEMENTATION", "PATH_CANONICAL_CURRENT", "PATH_HISTORICAL_OR_SUPERSEDED", "PR_EVIDENCE_ONLY", "PR_IMPLEMENTATION"] }, "reason": { "type": "string", "minLength": 1 }, "source": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["kind", "repository", "path", "blobSha", "locator"], "properties": { "kind": { "const": "PATH" }, "repository": { "type": "string" }, "path": { "type": "string", "minLength": 1 }, "blobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "locator": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "repository", "number", "locator"], "properties": { "kind": { "enum": ["ISSUE", "PR"] }, "repository": { "type": "string" }, "number": { "type": "integer", "minimum": 1 }, "locator": { "type": "string" } } } ] }, "target": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["repository", "type", "number"], "properties": { "repository": { "type": "string" }, "type": { "enum": ["ISSUE", "PR"] }, "number": { "type": "integer", "minimum": 1 } } }, { "type": "object", "additionalProperties": false, "required": ["repository", "type", "locator"], "properties": { "repository": { "type": "string" }, "type": { "const": "ARTIFACT" }, "locator": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["repository", "type", "locator", "path", "blobSha"], "properties": { "repository": { "type": "string" }, "type": { "const": "ARTIFACT" }, "locator": { "type": "string" }, "path": { "type": "string" }, "blobSha": { "type": ["string", "null"] } } } ] }, "referenced": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["repository", "number", "type", "title", "state", "stateReason", "labels", "priority", "milestone", "parentOwner"], "properties": { "repository": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] }, "number": { "type": "integer", "minimum": 1 }, "type": { "enum": ["ISSUE", "PR"] }, "title": { "type": "string" }, "state": { "enum": ["OPEN", "CLOSED"] }, "stateReason": { "type": ["string", "null"] }, "labels": { "type": "array", "items": { "type": "string" } }, "priority": { "enum": ["P0", "P1", "P2", "P3", null] }, "milestone": { "type": ["string", "null"] }, "parentOwner": { "type": ["string", "null"] } } } ] }, "latestEffective": { "oneOf": [ { "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["origin", "disposition", "canonicalRepository", "canonicalNumber", "pendingTransfer"], "properties": { "origin": { "enum": ["snapshot", "amendments"] }, "disposition": { "enum": ["TRANSFER", "KEEP_HUB"] }, "canonicalRepository": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] }, "canonicalNumber": { "type": "integer", "minimum": 1 }, "pendingTransfer": { "type": "boolean" } } }, { "type": "object", "additionalProperties": false, "required": ["origin", "disposition", "canonicalRepository", "canonicalNumber", "childIssues", "pendingTransfer"], "properties": { "origin": { "enum": ["snapshot", "amendments"] }, "disposition": { "const": "SPLIT_CHILDREN" }, "canonicalRepository": { "const": "AquilaXk/easysubway" }, "canonicalNumber": { "type": "integer", "minimum": 1 }, "childIssues": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["repository", "number"], "properties": { "repository": { "enum": ["AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] }, "number": { "type": "integer", "minimum": 1 } } } }, "pendingTransfer": { "const": false } } } ] }, "directOwner": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform", null] }, "consumerRoute": { "enum": ["PLAN-DOC", "PLAN-REPO", "PLAN-JOURNEY", null] }
    } } },
    "incomplete": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["stage", "code", "affectedIdentity"], "properties": { "stage": { "type": "string" }, "code": { "type": "string" }, "affectedIdentity": { "type": "string" } } } }
  }
}
