{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/plan-doc-execution-audit-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories", "planOwner", "historical", "self"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repositories": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] }
    },
    "planOwner": { "const": "PLAN-DOC" },
    "historical": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "issueNumber", "prNumber", "mergeSha", "relation", "planOwner", "changedPathClass", "allowedChangedFiles"],
      "properties": {
        "repository": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] }, "issueNumber": { "type": "integer", "minimum": 1 }, "prNumber": { "type": "integer", "minimum": 1 }, "mergeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "relation": { "enum": ["CLOSES", "COORDINATOR_FOLLOWUP"] }, "planOwner": { "const": "PLAN-DOC" },
        "changedPathClass": { "enum": ["HUB_GOVERNANCE_ONLY", "PLAN_DOC_CI_RECOVERY", "TARGET_DOCUMENTATION_FRAGMENT", "TARGET_PUBLIC_DOCUMENTATION"] },
        "allowedChangedFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$" } }
      }
    } },
    "self": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "issueNumber", "planOwner", "changedPathClass", "allowedChangedFiles"],
      "properties": {
        "repository": { "const": "AquilaXk/easysubway" }, "issueNumber": { "type": "integer", "minimum": 1 }, "planOwner": { "const": "PLAN-DOC" },
        "changedPathClass": { "const": "HUB_GOVERNANCE_ONLY" }, "allowedChangedFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$" } }
      }
    }
  }
}
