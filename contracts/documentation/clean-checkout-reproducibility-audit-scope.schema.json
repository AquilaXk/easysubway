{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/clean-checkout-reproducibility-audit-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slots"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "slots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "state", "ownerIssue", "evidenceSource"],
        "properties": {
          "repository": { "enum": ["AquilaXk/easysubway", "AquilaXk/easysubway-backend", "AquilaXk/easysubway-data", "AquilaXk/easysubway-mobile", "AquilaXk/easysubway-platform"] },
          "state": { "enum": ["PENDING", "READY"] },
          "ownerIssue": { "type": ["integer", "null"], "minimum": 1 },
          "evidenceSource": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["contractPath", "workflowPath", "artifactNamePrefix"],
                "properties": {
                  "contractPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[?#])[A-Za-z0-9][A-Za-z0-9._/-]*$" },
                  "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$" },
                  "artifactNamePrefix": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,86}-$" }
                }
              }
            ]
          }
        },
        "oneOf": [
          { "type": "object", "properties": { "state": { "const": "PENDING" }, "ownerIssue": { "type": "null" }, "evidenceSource": { "type": "null" } } },
          { "type": "object", "properties": { "state": { "const": "READY" }, "ownerIssue": { "type": "integer", "minimum": 1 }, "evidenceSource": { "type": "object" } } }
        ]
      }
    }
  }
}
