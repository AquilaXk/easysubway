{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/repository-split-issue-amendments.schema.json",
  "description": "repository-split-issues.json snapshot(71건 동결) 이후 생성된 hub issue의 분류 기록",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRepository", "snapshotLedger", "amendments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRepository": { "const": "AquilaXk/easysubway" },
    "snapshotLedger": { "const": "release/migrations/repository-split-issues.json" },
    "amendments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "type": "object",
            "required": ["disposition", "targetRepository", "targetUrl", "transferredAt"],
            "properties": {
              "disposition": { "const": "KEEP_HUB" },
              "targetRepository": { "const": "AquilaXk/easysubway" },
              "targetUrl": { "type": "null" },
              "transferredAt": { "type": "null" }
            }
          },
          {
            "type": "object",
            "required": ["disposition", "targetRepository", "targetUrl", "transferredAt"],
            "properties": {
              "disposition": { "const": "TRANSFER" },
              "targetRepository": {
                "enum": [
                  "AquilaXk/easysubway-data", "AquilaXk/easysubway-platform",
                  "AquilaXk/easysubway-backend", "AquilaXk/easysubway-mobile"
                ]
              },
              "targetUrl": { "type": "string", "pattern": "^https://github\\.com/AquilaXk/easysubway-(?:data|platform|backend|mobile)/issues/[1-9][0-9]*$" },
              "transferredAt": { "type": "string", "format": "date-time" }
            }
          }
        ],
        "required": [
          "sourceIssue", "title", "disposition", "targetRepository",
          "targetUrl", "transferredAt", "reason", "classifiedAt"
        ],
        "properties": {
          "sourceIssue": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["KEEP_HUB", "TRANSFER"] },
          "targetRepository": {
            "enum": [
              "AquilaXk/easysubway", "AquilaXk/easysubway-data", "AquilaXk/easysubway-platform",
              "AquilaXk/easysubway-backend", "AquilaXk/easysubway-mobile"
            ]
          },
          "targetUrl": { "type": ["string", "null"] },
          "transferredAt": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "classifiedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
