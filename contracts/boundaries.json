{
  "schemaVersion": 2,
  "areas": {
    "mobile": { "roots": ["apps/mobile"] },
    "backend": { "roots": ["backend"] },
    "datapack": { "roots": ["tools/datapack"] },
    "routeMap": { "roots": ["tools/route-map", "tools/routes"] },
    "realtime": { "roots": ["tools/realtime"] },
    "release": { "roots": ["tools/release", "apps/mobile/release"] },
    "infra": { "roots": ["infra", "tools/deploy"] },
    "ops": { "roots": ["tools/ops"] },
    "security": { "roots": ["tools/security"] },
    "ci": { "roots": [".github/workflows", "tools/ci", "tools/repo"] },
    "contracts": { "roots": ["contracts"] }
  },
  "extractionTargets": {
    "data": {
      "repository": "AquilaXk/easysubway-data",
      "sourceAreas": ["datapack"],
      "ownedRoots": ["tools/route-map"],
      "partialRoots": ["tools/routes"]
    },
    "platform": {
      "repository": "AquilaXk/easysubway-platform",
      "sourceAreas": ["infra"],
      "ownedRoots": ["tools/deploy"],
      "partialRoots": ["tools/ops"]
    },
    "backend": {
      "repository": "AquilaXk/easysubway-backend",
      "sourceAreas": ["backend"],
      "ownedRoots": ["tools/qa"],
      "partialRoots": ["tools/routes", "tools/realtime", "tools/security"]
    },
    "mobile": {
      "repository": "AquilaXk/easysubway-mobile",
      "sourceAreas": ["mobile"],
      "ownedRoots": ["tools/mobile"],
      "partialRoots": ["tools/release", "tools/security"]
    }
  },
  "splitOrder": ["data", "platform", "backend", "mobile"],
  "forbiddenReferences": [
    {
      "from": "apps/mobile/lib",
      "pattern": "\\.\\./backend",
      "reason": "mobile은 backend 소스를 모른다"
    },
    {
      "from": "backend/src",
      "pattern": "apps/mobile",
      "reason": "backend는 mobile 소스를 모른다"
    },
    {
      "from": "tools/datapack",
      "pattern": "apps/mobile/lib",
      "reason": "datapack 도구는 앱 구현을 모른다. assets 산출물 경로만 허용"
    }
  ],
  "allowlist": []
}
