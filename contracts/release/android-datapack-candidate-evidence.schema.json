{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "candidateBinding", "freshnessExpiresAt", "mobileIdentity", "sourceActionsArtifact", "oci", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "artifactKind": { "const": "android-datapack-candidate-evidence" },
    "candidateBinding": { "type": "object", "additionalProperties": false, "required": ["candidateId", "tupleSha256", "buildSpecSha256", "manifestSha256"], "properties": { "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }, "tupleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "buildSpecSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "freshnessExpiresAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "mobileIdentity": { "type": "object", "additionalProperties": false, "required": ["gitSha", "androidApplicationId", "versionCode", "aabSha256", "aabPayloadSha256", "dataPackManifestSha256"], "properties": { "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "androidApplicationId": { "const": "com.easysubway.app" }, "versionCode": { "type": "integer", "minimum": 1 }, "aabSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "aabPayloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "dataPackManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "sourceActionsArtifact": { "type": "object", "additionalProperties": false, "required": ["repository", "workflowPath", "runId", "artifactId", "artifactName", "archiveDigest", "headSha", "createdAt", "expiresAt"], "properties": { "repository": { "const": "AquilaXk/easysubway" }, "workflowPath": { "const": ".github/workflows/release-artifacts.yml" }, "runId": { "type": "integer", "minimum": 1 }, "artifactId": { "type": "integer", "minimum": 1 }, "artifactName": { "type": "string", "minLength": 1 }, "archiveDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "createdAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "expiresAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" } } },
    "oci": { "type": "object", "additionalProperties": false, "required": ["namespace", "bucket", "objectKey", "objectUri", "objectSha256", "byteSize", "putAt", "putEtag", "putVersionId", "getAt", "getEtag", "getVersionId", "getSha256", "getByteSize", "createOnly"], "properties": { "namespace": { "type": "string", "minLength": 1 }, "bucket": { "type": "string", "minLength": 1 }, "objectKey": { "type": "string", "minLength": 1 }, "objectUri": { "type": "string", "pattern": "^oci://" }, "objectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byteSize": { "type": "integer", "minimum": 1 }, "putAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "putEtag": { "type": "string", "minLength": 1 }, "putVersionId": { "type": "string", "minLength": 1 }, "getAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "getEtag": { "type": "string", "minLength": 1 }, "getVersionId": { "type": "string", "minLength": 1 }, "getSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "getByteSize": { "type": "integer", "minimum": 1 }, "createOnly": { "const": true } } },
    "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
