{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "candidateBinding", "freshnessExpiresAt", "mobileIdentity", "sourceActionsArtifact", "oci", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "artifactKind": { "const": "android-datapack-candidate-evidence" },
    "candidateBinding": { "type": "object", "additionalProperties": false, "required": ["candidateId", "buildSpecSha256", "manifestSha256"], "properties": { "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }, "buildSpecSha256": { "$ref": "#/$defs/sha256" }, "manifestSha256": { "$ref": "#/$defs/sha256" } } },
    "freshnessExpiresAt": { "$ref": "#/$defs/utcMilliseconds" },
    "mobileIdentity": { "type": "object", "additionalProperties": false, "required": ["gitSha", "androidApplicationId", "versionCode", "aabSha256", "aabPayloadSha256", "dataPackManifestSha256"], "properties": { "gitSha": { "$ref": "#/$defs/gitSha" }, "androidApplicationId": { "const": "com.easysubway.app" }, "versionCode": { "type": "integer", "minimum": 1 }, "aabSha256": { "$ref": "#/$defs/sha256" }, "aabPayloadSha256": { "$ref": "#/$defs/sha256" }, "dataPackManifestSha256": { "$ref": "#/$defs/sha256" } } },
    "sourceActionsArtifact": { "type": "object", "additionalProperties": false, "required": ["repository", "workflowPath", "runId", "artifactId", "artifactName", "archiveDigest", "headSha", "createdAt", "expiresAt"], "properties": { "repository": { "const": "AquilaXk/easysubway" }, "workflowPath": { "const": ".github/workflows/release-artifacts.yml" }, "runId": { "type": "integer", "minimum": 1 }, "artifactId": { "type": "integer", "minimum": 1 }, "artifactName": { "type": "string", "minLength": 1 }, "archiveDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "headSha": { "$ref": "#/$defs/gitSha" }, "createdAt": { "$ref": "#/$defs/utcMilliseconds" }, "expiresAt": { "$ref": "#/$defs/utcMilliseconds" } } },
    "oci": { "type": "object", "additionalProperties": false, "required": ["namespace", "bucket", "objectKey", "objectUri", "objectSha256", "byteSize", "putAt", "putEtag", "putVersionId", "getAt", "getEtag", "getVersionId", "getSha256", "getByteSize", "createOnly"], "properties": { "namespace": { "type": "string", "minLength": 1 }, "bucket": { "type": "string", "minLength": 1 }, "objectKey": { "type": "string", "minLength": 1 }, "objectUri": { "type": "string", "pattern": "^oci://" }, "objectSha256": { "$ref": "#/$defs/sha256" }, "byteSize": { "type": "integer", "minimum": 1 }, "putAt": { "$ref": "#/$defs/utcMilliseconds" }, "putEtag": { "type": "string", "minLength": 1 }, "putVersionId": { "type": "string", "minLength": 1 }, "getAt": { "$ref": "#/$defs/utcMilliseconds" }, "getEtag": { "type": "string", "minLength": 1 }, "getVersionId": { "type": "string", "minLength": 1 }, "getSha256": { "$ref": "#/$defs/sha256" }, "getByteSize": { "type": "integer", "minimum": 1 }, "createOnly": { "const": true } } },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "utcMilliseconds": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" } }
}
